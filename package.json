{
	"name": "llm-chat-app-server",
	"version": "2.0.0",
	"description": "Production-ready AI chat application with Cloudflare Workers AI and D1 database",
	"main": "src/index.ts",
	"cloudflare": {
		"label": "AI Chat App Production",
		"products": ["Workers", "Workers AI", "D1"],
		"categories": ["ai", "chat"]
	},
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc --noEmit && wrangler deploy --dry-run",
		"deploy:auth": "bash deploy.sh",
		"dev": "wrangler dev --port 8787",
		"start": "wrangler dev",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.7.0",
		"@cloudflare/workers-types": "^4.20250425.0",
		"@types/node": "^24.0.0",
		"p-limit": "^6.2.0",
		"typescript": "^5.9.3",
		"vitest": "^2.1.8",
		"wrangler": "^4.56.0"
	},
	"keywords": ["ai", "chat", "workers", "d1", "production"],
	"author": "AI Chat Team",
	"license": "MIT"
}
